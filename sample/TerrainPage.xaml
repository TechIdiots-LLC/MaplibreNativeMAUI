<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             x:Class="MauiSample.TerrainPage"
             Title="3D Terrain">

    <!-- The map is pinned in row 0 and only the controls beneath it scroll. It used to
         share one ScrollView with them, but the on-map controls are children of the map,
         so scrolling the page carried them out of view - the terrain button first, being
         the topmost. The map's height is still set in code-behind to a fraction of the
         page so a strip of controls always shows below it, which is what keeps "drag the
         map to pan" and "drag the controls to scroll" unambiguous. -->
    <Grid RowDefinitions="Auto,*">

        <maplibre:MapLibreMap
            Grid.Row="0"
            x:Name="Map"
            HeightRequest="400"
            ShowNavigationControls="True"
            ShowTerrainControl="True"
            TerrainControlSourceId="__terrain-dem"
            NavigationControlPosition="TopRight"
            TerrainControlPosition="TopRight"
            AttributionControlPosition="BottomLeft" />

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Spacing="8" Padding="12">

                <Label FontAttributes="Bold" FontSize="16" Text="3D Terrain Toggle" />

                <Label TextColor="Gray" FontSize="12" Text=
                    "The terrain button on the map (above the navigation control) is the built-in terrain control — it toggles terrain on the raster-dem source added below. Or use the button here. Navigate to the source's coverage (e.g. the Alps) and tilt with two fingers to see the relief." />

                <Label Text="Style:" FontAttributes="Bold" />
                <Picker x:Name="StylePicker" SelectedIndexChanged="OnStyleChanged" />

                <Label Text="Terrain source:" FontAttributes="Bold" />
                <Picker x:Name="TerrainPicker" />
                <Entry x:Name="CustomTerrainEntry"
                       Placeholder="…or paste a custom tilejson/tiles URL (overrides the picker)"
                       Keyboard="Url" />

                <Label Text="Terrain load mode:" FontAttributes="Bold" />
                <Label TextColor="Gray" FontSize="12" Text=
                    "How much terrain tile/drape work each frame may do while terrain loads. Quality (the default) builds everything at once and can stall a frame on a big burst; Balanced and Performance spread the work out for smoother interaction on weaker GPUs, at the cost of visible fill-in." />
                <Picker x:Name="LoadModePicker" SelectedIndexChanged="OnLoadModeChanged" />

                <HorizontalStackLayout Spacing="8">
                    <Switch x:Name="ClampSwitch" Toggled="OnClampToggled" VerticalOptions="Center" />
                    <Label Text="Clamp the centre to the ground" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label TextColor="Gray" FontSize="12" Text=
                    "As in maplibre-gl-js: the map centre follows the terrain surface, so tilting over a mountain turns round the ground being looked at and the camera stays above it, instead of sinking towards a point at sea level." />

                <HorizontalStackLayout Spacing="8">
                    <Switch x:Name="SkirtSwitch" Toggled="OnSkirtToggled" VerticalOptions="Center" />
                    <Label Text="Terrain tile skirts" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label TextColor="Gray" FontSize="12" Text=
                    "The vertical strips along each terrain tile's edges that hide gaps between tiles at different zoom levels. Turn them off for a map drawn over a transparent background, where they show as walls." />

                <Button x:Name="ToggleButton"
                        Text="Enable 3D Terrain"
                        Clicked="OnToggleTerrain"
                        BackgroundColor="#1E88E5" TextColor="White"
                        Padding="12,6" HorizontalOptions="Start" />

                <Label x:Name="StatusLabel" FontSize="12" TextColor="Gray" Text="Terrain: off" />

                <Label Text="Tap the map:" FontAttributes="Bold" />
                <Label TextColor="Gray" FontSize="12" Text=
                    "With terrain on, a tap reports the ground under the finger: the nearest surface along its line of sight. The camera-centre plane pick is what camera code uses to turn a screen point into a centre; tilted over high ground it lands well behind the tapped spot." />
                <Label x:Name="TapLabel" FontSize="12" Text="Tap the map to see where it lands." />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
