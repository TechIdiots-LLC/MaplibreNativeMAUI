<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             x:Class="MauiSample.ControlsPage"
             Title="Controls">

    <!-- The app's own controls (MapLibreMap.AddControl, in code-behind) stack in the corners with the built-in ones.
         The label laid over the map's middle reads MapLibreMap.ControlInsets: the room the controls take in each
         corner, for overlays of the app's own to keep clear of. -->
    <Grid>
        <maplibre:MapLibreMap
            x:Name="Map"
            StyleUrl="https://demotiles.maplibre.org/style.json"
            ShowNavigationControls="True"
            ShowGpsControl="True"
            ShowTerrainControl="True" />

        <Label x:Name="InsetsLabel"
               HorizontalOptions="Center" VerticalOptions="Center"
               Padding="8,4" FontSize="12"
               BackgroundColor="#CCFFFFFF" TextColor="Black" />
    </Grid>
</ContentPage>
