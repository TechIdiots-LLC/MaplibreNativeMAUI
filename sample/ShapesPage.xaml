<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             xmlns:overlays="clr-namespace:MapLibreNative.Maui.Handlers.Overlays;assembly=MapLibreNative.Maui.Handlers"
             x:Class="MauiSample.ShapesPage"
             Title="Shapes">

    <!--
        Declarative over-the-map overlay elements (Polyline / Polygon / Circle) as children of
        MapLibreMap. Each element materialises itself as a GeoJSON source + style layer when the
        style loads. Geometry (Geopath, Center, Radius) is set in code-behind because Location /
        Distance are not expressible as XAML literals; colours and stroke are set here.
    -->
    <!-- The map is pinned in row 0 and only the controls beneath it scroll. It used to
         share one ScrollView with them, but the on-map controls are children of the map,
         so scrolling the page carried them out of view - the terrain button first, being
         the topmost. The map's height is still set in code-behind to a fraction of the
         page so a strip of controls always shows below it, which is what keeps "drag the
         map to pan" and "drag the controls to scroll" unambiguous. -->
    <Grid RowDefinitions="Auto,*">

        <maplibre:MapLibreMap x:Name="Map"
                              Grid.Row="0"
                              HeightRequest="400"
                              StyleUrl="{Binding StyleUrl}"
                              MapReady="OnMapReady">

            <overlays:Polygon x:Name="Region"
                              FillColor="#553BB273"
                              StrokeColor="#2E7D32"
                              StrokeWidth="2" />

            <overlays:Polyline x:Name="Route"
                               StrokeColor="#1E88E5"
                               StrokeWidth="4" />

            <overlays:Circle x:Name="RadiusCircle"
                             FillColor="#33F57C00"
                             StrokeColor="#F57C00"
                             StrokeWidth="2" />
        </maplibre:MapLibreMap>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <HorizontalStackLayout Spacing="8" Padding="8">
                    <Button Text="Grow circle"   Clicked="OnGrow" />
                    <Button Text="Shrink circle" Clicked="OnShrink" />
                </HorizontalStackLayout>

                <Label Text="{Binding Status}" Padding="8,4" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
