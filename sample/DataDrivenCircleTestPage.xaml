<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
             xmlns:local="clr-namespace:MauiSample"
             x:DataType="local:DataDrivenCircleTestViewModel"
             x:Class="MauiSample.DataDrivenCircleTestPage"
             Title="Data-Driven Test">

    <!-- The map is pinned in row 0 and only the controls beneath it scroll. It used to
         share one ScrollView with them, but the on-map controls are children of the map,
         so scrolling the page carried them out of view - the terrain button first, being
         the topmost. The map's height is still set in code-behind to a fraction of the
         page so a strip of controls always shows below it, which is what keeps "drag the
         map to pan" and "drag the controls to scroll" unambiguous. -->
    <Grid RowDefinitions="Auto,*">

        <maplibre:MapLibreMap x:Name="Map"
                              Grid.Row="0"
                              HeightRequest="400"
                              StyleUrl="{Binding StyleUrl}"
                              MapReady="OnMapReady" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <HorizontalStackLayout Spacing="8" Padding="8">
                    <Button x:Name="RunTestButton" Text="Run Test" Clicked="OnRunTest" />
                </HorizontalStackLayout>

                <Label Text="{Binding Status}" Padding="8,4" FontFamily="Courier" FontSize="11" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
